# ═══════════════════════════════════════════════════════════
# 3 Series Bot — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Polymarket CLOB API Credentials ──
# Get these from: https://polymarket.com (Settings → API)
POLY_API_KEY=your_api_key_here
POLY_API_SECRET=your_api_secret_here
POLY_API_PASSPHRASE=your_passphrase_here

# ── Wallet ──
# Your Ethereum private key (for signing Gnosis Safe transactions)
POLY_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Your Gnosis Safe proxy wallet address on Polygon
POLY_FUNDER_ADDRESS=0xYOUR_SAFE_ADDRESS_HERE

# ── Telegram Notifications ──
# Create a bot via @BotFather on Telegram
TRADE_BOT_TOKEN=your_telegram_bot_token
TRADE_CHAT_ID=your_telegram_chat_id

# ── Trading Mode ──
# LIVE = real money | OBSERVATION = paper trading (logs only)
MODE=OBSERVATION

# ── Strategy Parameters ──
TRIGGER_N=3
BET_SIZE=10.00
BET_PRICE=0.49
FILL_TIMEOUT=900
WINDOW=900
COINS=btc,eth,sol,xrp

# ── Proxy (optional, required if geo-blocked) ──
# HTTPS_PROXY=http://user:pass@host:port

# ── Polygon RPC ──
RPC_URL=https://polygon-bor-rpc.publicnode.com
